      <data key="d21">9606</data>
      <data key="d22">GO:0004090; GO:0005634; GO:0005635; GO:0005654; GO:0005737; GO:0005739; GO:0005759; GO:0008207; GO:0008285; GO:0009636; GO:0016616; GO:0022900; GO:0034599; GO:0043011; GO:0043066</data>
