      <data key="d22">GO:0000502; GO:0002376; GO:0005634; GO:0005654; GO:0005737; GO:0005829; GO:0005839; GO:0006281; GO:0006915; GO:0006974; GO:0006979; GO:0008021; GO:0010498; GO:0010499; GO:0019773; GO:0030317; GO:0032729; GO:0032743; GO:0032760; GO:0034341; GO:0034515; GO:0042802; GO:0043161; GO:0043374; GO:0045061; GO:0045063; GO:0045590; GO:0061136; GO:0070062; GO:0071357; GO:0072539; GO:0140756; GO:0160165; GO:2000045</data>
