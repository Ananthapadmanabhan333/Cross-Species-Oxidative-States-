      <data key="d14">nth DR_0289</data>
      <data key="d15">Endonuclease III (EC 4.2.99.18) (DNA-(apurinic or apyrimidinic site) lyase)</data>
      <data key="d16">243230</data>
      <data key="d17">GO:0003677; GO:0006285; GO:0019104; GO:0051539; GO:0140078</data>
      <data key="d18">True</data>
